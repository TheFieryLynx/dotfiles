(include "./windows/bar.yuck")


(defwindow bar
  :monitor 0
  :windowtype "dock"
  :exclusive true
  :geometry (geometry :x "0%"
                      :y "0%"
                      :width "100%"
                      :height "0"
                      :anchor "top center"
            )
  :reserve (struts :side "top" :distance "0%")
  (bar))
