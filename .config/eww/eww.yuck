(include "./widgets/bar/main.yuck")
(include "./widgets/notifications/main.yuck")


(defwindow bar
  :monitor 1
  :windowtype "dock"
  :exclusive true
  :geometry (geometry :x "0%"
                      :y "0%"
                      :width "100%"
                      :height "0"
                      :anchor "top center"
            )
  :reserve (struts :side "top" :distance "0%")
  (bar)
)

(defwindow notifications
  :monitor 1
  :geometry (geometry :x "20px"
                     :y "20px"
                     :anchor "top right")
  :stacking "overlay"
  :windowtype: "popup"
  (notification)
)
