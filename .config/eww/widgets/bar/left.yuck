(deflisten hypr_active_workspace "~/.config/eww/scripts/hyprland/active_workspace.sh")


(defwidget test []
  (box :class "test"
       :orientation "h"
    (label :class "time_text" 
           :text "${hypr_active_workspace}"
    )
  )
)


(defwidget workspace_item [index]
  (eventbox
    :cursor "pointer"
    (box :class "workspace_box"
      (button :onclick "hyprctl dispatch workspace ${index}"
              :class "workspace_button"    
        (label :class "workspace_button_icon" 
               :text { hypr_active_workspace == index ? "" : "" }
        )
      )
    )       
  )
)

(defwidget workspaces []
  (box :class "workspaces"
       :orientation "h"
       :space-evenly true
       :halign "start"
       :spacing 0
       (workspace_item :index 1)
       (workspace_item :index 2)
       (workspace_item :index 3)
       (workspace_item :index 4)
       (workspace_item :index 5)
       (workspace_item :index 6)
  )       
)


(defwidget workspace_to_the_left []
  (eventbox
    :cursor "pointer"
    (box :class ""
         :orientation "h"
      (button :onclick "hyprctl dispatch workspace -1"
              :class "left_ws_button"
        (box
          (divider :dir "left" :num 102)
          (inverted_divider :dir "left" :num 101)
        )
      )
    )
  )
)

(defwidget workspace_to_the_right []
  (eventbox
    :cursor "pointer"
    (box :class ""
         :orientation "h"
      (button :onclick "hyprctl dispatch workspace +1"
              :class "right_ws_button"
        (box
          (inverted_divider :dir "right" :num 101)
          (divider :dir "right" :num 102)
        )
      )
    )
  )
)

(defwidget left []
  (box :orientation "h"
       :halign "start"
       :space-evenly false
       :spacing 0
    (workspace_to_the_left)
    (divider :dir "left" :num 101)
    (workspaces)  
    (divider :dir "right" :num 101)
    (workspace_to_the_right)
  )
)
