(defpoll current_time :interval "5s" "date +'%H:%M'")
(defpoll cpu_usage :interval "5s" "grep 'cpu ' /proc/stat | awk '{print int(($2+$4)*100/($2+$4+$5))}'")
(defpoll mem_usage :interval "5s" "free | awk '/Mem:/ {printf \"%d\", $3/$2 * 100}'")
(defpoll current_date :interval "5m" "date +'%d-%m'")
(defpoll cpu_temp :interval "5s" "awk '{print $1/1000}' /sys/class/thermal/thermal_zone1/temp")
(deflisten keyboard_layout "~/.config/eww/scripts/hyprland/keyboard_layout.sh")


(defwidget distro_icon []
  (box :class "distro_box"
       :orientation "h"
    (label :class "distro_icon" 
           :text "󰣇" 
    )
  )
)

(defwidget time []
  (box :class "time_box"
       :orientation "h"
       :space-evenly false
       :spacing 0
       :halign "center"
    (label :class "time_icon" :text "")  
    (label :class "time_text" :text {current_time})
  )
)

(defwidget cpu []
  (box :class "cpu_box"
       :orientation "h"
       :space-evenly false
       :spacing 0
       :halign "center"
    (label :class "cpu_icon" :text "󰍛")  
    (label :class "cpu_text" :text "${cpu_usage}%")
  )
)

(defwidget memory []
  (box :class "memory_box"
       :orientation "h"
       :space-evenly false
       :spacing 0
       :halign "center"
    (label :class "memory_icon" :text "󰘚")  
    (label :class "memory_text" :text "${mem_usage}%")
  )
)

(defwidget date []
  (box :class "date_box"
       :orientation "h"
       :space-evenly false
       :spacing 0
       :halign "center"
    (label :class "date_icon" :text "󰸘")  
    (label :class "date_text" :text "${current_date}")
  )
)


(defwidget temp []
  (box :class "temp_box"
       :orientation "h"
       :space-evenly false
       :spacing 0
       :halign "center"
    (label :class "temp_icon" :text "󱃃") ;;   "󱃃", "󰔏", "󱃂"
    (label :class "temp_text" :text "${cpu_temp}°C")
  )
)

(defwidget layout []
  (box :class "layout_box"
       :orientation "h"
       :space-evenly false
       :spacing 0
       :halign "center"
    (label :class "layout_icon" :text "󰌌")
    (label :text "${keyboard_layout}")
  )
)



(defwidget left_side []
  (box :orientation "h"
       :space-evenly false
       :spacing 0
    (divider :dir "left" :num 4)
    (temp)
    (inverted_divider :dir "left" :num 3)
    
    (divider :dir "left" :num 3)
    (memory)
    (inverted_divider :dir "left" :num 2)

    (divider :dir "left" :num 2)
    (cpu)
    (inverted_divider :dir "left" :num 1)
  )
)

(defwidget right_side []
  (box :orientation "h"
       :space-evenly false
       :spacing 0
    (inverted_divider :dir "right" :num 1)
    (time)
    (divider :dir "right" :num 2)
    
    (inverted_divider :dir "right" :num 2)
    (date)
    (divider :dir "right" :num 3)
    
    (inverted_divider :dir "right" :num 3)
    (layout)
    (divider :dir "right" :num 4)
  )
)

(defwidget center []
  (box :orientation "h"
       :space-evenly false
       :spacing 0
       :halign "center"
    (left_side)
    (divider :dir "left" :num 1)
    (distro_icon)  
    (divider :dir "right" :num 1)
    (right_side)
  )
)
