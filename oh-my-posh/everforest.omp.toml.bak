# ~/.poshthemes/everforest.omp.toml
schema = "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json"
final_space = true
console_title_template = "{{ .Shell }} in {{ .Folder }}"

[transient_prompt]
  foreground = "#a7c080"
  background = "transparent"
  template = "➜ "

[[blocks]]
  alignment = "left"
  type = "prompt"

  [[blocks.segments]]
    type = "path"
    style = "powerline"
    powerline_symbol = "\uE0B0"
    foreground = "#d3c6aa"
    background = "#2b3339"
    template = " \uF07C {{ .Path }} "

  [[blocks.segments]]
    type = "git"
    style = "powerline"
    powerline_symbol = "\uE0B0"
    foreground = "#d3c6aa"
    background = "#4b565c"
    template = " {{ .HEAD }} {{ if .Staging.Changed }}\uF046 {{ .Staging.String }}{{ end }}{{ if .Working.Changed }}\uF044 {{ .Working.String }}{{ end }} "

[[blocks]]
  alignment = "right"
  type = "prompt"

  [[blocks.segments]]
    type = "time"
    style = "powerline"
    powerline_symbol = "\uE0B2"
    foreground = "#d3c6aa"
    background = "#4b565c"
    template = " \uF017 {{ .CurrentDate | date \"15:04\" }} "
